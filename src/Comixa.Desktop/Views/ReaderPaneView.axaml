<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:Avalonia.Media"
             xmlns:vm="using:Comixa.Desktop.ViewModels"
             x:Class="Comixa.Desktop.Views.ReaderPaneView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <Grid x:Name="ReaderGrid">
    <Border IsVisible="{Binding IsSettingsPanelVisible}"
            Background="{DynamicResource ComixaSurfaceBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40">
          <TextBlock Text="Settings"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaOnSurfaceBrush}" />

          <StackPanel Spacing="10">
            <TextBlock Text="GLOBAL SETTINGS"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <WrapPanel>
              <ToggleButton Content="Continue where left off"
                            Margin="0,0,6,6"
                            IsChecked="{Binding OpenComicsAtLastPosition, Mode=OneWay}"
                            Command="{Binding ToggleOpenComicsAtLastPositionCommand}" />
              <ToggleButton Content="Open fullscreen"
                            Margin="0,0,6,6"
                            IsChecked="{Binding OpenComicsInFullscreen, Mode=OneWay}"
                            Command="{Binding ToggleOpenComicsInFullscreenCommand}" />
              <ToggleButton Content="Right preview pane"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsReaderPreviewPaneEnabled, Mode=OneWay}"
                            Command="{Binding ToggleReaderPreviewPaneCommand}" />
              <ToggleButton Content="Dark theme"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                            Command="{Binding ToggleThemeCommand}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="READING DIRECTION"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Spacing="8">
              <RadioButton Content="Left to Right"
                           GroupName="Direction"
                           IsChecked="{Binding IsLeftToRight, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="ltr" />
              <RadioButton Content="Right to Left"
                           GroupName="Direction"
                           IsChecked="{Binding IsRightToLeft, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="rtl" />
              <RadioButton Content="Top to Bottom"
                           GroupName="Direction"
                           IsChecked="{Binding IsTopToBottom, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="ttb" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="READER BEHAVIOR"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <WrapPanel>
              <ToggleButton Content="Edge clicks"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsEdgePageTurnEnabled, Mode=OneWay}"
                            Command="{Binding ToggleEdgePageTurnsCommand}" />
              <ToggleButton Content="Drag turns"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsDragPageTurnEnabled, Mode=OneWay}"
                            Command="{Binding ToggleDragPageTurnsCommand}" />
              <ToggleButton Content="Invert turns"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsPageTurnInverted, Mode=OneWay}"
                            Command="{Binding TogglePageTurnInversionCommand}" />
              <ToggleButton Content="{Binding PageLayoutLabel}"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsTwoPageMode, Mode=OneWay}"
                            Command="{Binding ToggleTwoPageModeCommand}" />
              <Button Content="Reset reader defaults"
                      Margin="0,0,6,6"
                      Command="{Binding ResetReaderDefaultsCommand}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="MOUSE WHEEL"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton Content="Scroll"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelScrollAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="scroll" />
              <RadioButton Content="Pages"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelPageTurnAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="page" />
              <RadioButton Content="Zoom"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelZoomAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="zoom" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="TONE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <WrapPanel>
              <RadioButton Content="Original"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneOriginal, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="original" />
              <RadioButton Content="Warm"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneWarm, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="warm" />
              <RadioButton Content="Paper"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderTonePaper, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="paper" />
              <RadioButton Content="Cool"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneCool, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="cool" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="PAGE ANIMATION"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton Content="None"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationNone, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="none" />
              <RadioButton Content="Fade"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationFade, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="fade" />
              <RadioButton Content="Slide"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationSlide, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="slide" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="KEYBOARD SHORTCUTS"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <TextBlock Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                       FontSize="12"
                       Text="Left / Right - navigate pages&#xA;Page Up / Page Down - navigate pages&#xA;Home / End - first / last page&#xA;F - Fit Page / Fit Width&#xA;F11 - fullscreen reader&#xA;Esc - exit fullscreen&#xA;B - toggle bookmark&#xA;S - settings&#xA;Right-click card - mark read / shelves" />
          </StackPanel>

          <Button Content="Close Settings"
                  Command="{Binding ToggleSettingsPanelCommand}"
                  Background="{DynamicResource ComixaPrimaryBrush}"
                  Foreground="#001B12" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid RowDefinitions="Auto,*,Auto"
          IsVisible="{Binding !IsSettingsPanelVisible}"
          Background="{Binding ReaderBackgroundBrush}">
      <Border Padding="12,7" Background="#DD000000">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{Binding ReaderStatus}"
                     Foreground="White"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsPageLoading}"
                       Width="80"
                       Height="3"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ComixaPrimaryBrush}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding CurrentPageLabel}"
                     Foreground="#D0FFFFFF"
                     VerticalAlignment="Center"
                     MinWidth="80"
                     TextAlignment="Right" />
        </Grid>
      </Border>

      <Grid x:Name="ReaderPageHost"
            Grid.Row="1"
            IsVisible="{Binding !IsVerticalMode}"
            Background="Transparent">
        <ScrollViewer IsVisible="{Binding IsFitPageMode}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Grid MinHeight="400">
            <LayoutTransformControl Margin="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSinglePageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid>
                <Image Source="{Binding CurrentPageImage}"
                       Stretch="Uniform" />
                <Border Background="{Binding ReaderPageTintBrush}"
                        IsVisible="{Binding IsReaderTintVisible}"
                        IsHitTestVisible="False" />
              </Grid>
            </LayoutTransformControl>

            <LayoutTransformControl Margin="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsTwoPageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid ColumnDefinitions="Auto,Auto">
                <Grid Margin="0,0,8,0">
                  <Image Source="{Binding CurrentPageImage}"
                         Stretch="Uniform" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
                <Grid Grid.Column="1"
                      Margin="8,0,0,0"
                      IsVisible="{Binding HasNextPageImage}">
                  <Image Source="{Binding NextPageImage}"
                         Stretch="Uniform" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
              </Grid>
            </LayoutTransformControl>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding !HasSelectedBook}">
              <TextBlock Text="Select a book to start reading"
                         Foreground="White"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Click a comic in the library or use the keyboard to navigate"
                         Foreground="#A0FFFFFF"
                         TextWrapping="Wrap"
                         MaxWidth="320"
                         TextAlignment="Center"
                         FontSize="12" />
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsFitWidthMode}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <LayoutTransformControl HorizontalAlignment="Stretch"
                                    IsVisible="{Binding IsSinglePageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid>
                <Image Source="{Binding CurrentPageImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch" />
                <Border Background="{Binding ReaderPageTintBrush}"
                        IsVisible="{Binding IsReaderTintVisible}"
                        IsHitTestVisible="False" />
              </Grid>
            </LayoutTransformControl>

            <LayoutTransformControl HorizontalAlignment="Stretch"
                                    IsVisible="{Binding IsTwoPageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid ColumnDefinitions="*,*">
                <Grid Margin="0,0,4,0">
                  <Image Source="{Binding CurrentPageImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Stretch" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
                <Grid Grid.Column="1"
                      Margin="4,0,0,0"
                      IsVisible="{Binding HasNextPageImage}">
                  <Image Source="{Binding NextPageImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Stretch" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
              </Grid>
            </LayoutTransformControl>
          </Grid>
        </ScrollViewer>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    IsVisible="{Binding IsVerticalMode}"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding VerticalPages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Image Source="{Binding}" Stretch="Uniform" Margin="0,2" MaxWidth="960" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="12,9" Background="#DD000000">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Button Content="Previous"
                    Command="{Binding PreviousPageCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Previous page" />
            <Button Content="Next"
                    Command="{Binding NextPageCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Next page" />
            <Button Content="{Binding NextSeriesBookActionLabel}"
                    Command="{Binding OpenNextSeriesBookCommand}"
                    IsVisible="{Binding HasNextSeriesBookPrompt}"
                    Background="{DynamicResource ComixaPrimaryBrush}"
                    Foreground="#001B12"
                    BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                    BorderThickness="1"
                    ToolTip.Tip="Open the next part in this series" />
          </StackPanel>

          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentPageLabel}"
                     Foreground="White"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding ZoomLabel}"
                       Foreground="#B8FFFFFF"
                       VerticalAlignment="Center"
                       FontSize="12" />

            <Button Content="{Binding BookmarkIcon}"
                    Command="{Binding ToggleBookmarkCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Toggle bookmark (B)" />

            <Button Content="{Binding FitModeLabel}"
                    Command="{Binding ToggleFitModeCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Fit Page / Fit Width (F)" />

            <Button Content="{Binding PageLayoutLabel}"
                    Command="{Binding ToggleTwoPageModeCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Toggle one/two page layout" />

            <Button Content="{Binding ReaderFullscreenLabel}"
                    Command="{Binding ToggleReaderFullscreenCommand}"
                    Background="#26313D"
                    Foreground="White"
                    BorderBrush="#667484"
                    BorderThickness="1"
                    ToolTip.Tip="Fullscreen reader (F11)" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
