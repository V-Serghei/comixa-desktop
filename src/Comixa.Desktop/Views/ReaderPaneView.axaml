<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:Avalonia.Media"
             xmlns:vm="using:Comixa.Desktop.ViewModels"
             x:Class="Comixa.Desktop.Views.ReaderPaneView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <Grid x:Name="ReaderGrid">
    <Border IsVisible="{Binding IsReaderSettingsPanelVisible}"
            Background="{DynamicResource ComixaSurfaceBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="40">
          <TextBlock Text="Reader Settings"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaOnSurfaceBrush}" />

          <StackPanel Spacing="10">
            <TextBlock Text="READING DIRECTION"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Spacing="8">
              <RadioButton Content="Left to Right"
                           GroupName="Direction"
                           IsChecked="{Binding IsLeftToRight, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="ltr" />
              <RadioButton Content="Right to Left"
                           GroupName="Direction"
                           IsChecked="{Binding IsRightToLeft, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="rtl" />
              <RadioButton Content="Top to Bottom"
                           GroupName="Direction"
                           IsChecked="{Binding IsTopToBottom, Mode=OneWay}"
                           Command="{Binding SetReadingDirectionCommand}"
                           CommandParameter="ttb" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="READER BEHAVIOR"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <WrapPanel>
              <ToggleButton Content="Edge clicks"
                            Classes="filterChip"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsEdgePageTurnEnabled, Mode=OneWay}"
                            Command="{Binding ToggleEdgePageTurnsCommand}" />
              <ToggleButton Content="Drag turns"
                            Classes="filterChip"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsDragPageTurnEnabled, Mode=OneWay}"
                            Command="{Binding ToggleDragPageTurnsCommand}" />
              <ToggleButton Content="Invert turns"
                            Classes="filterChip"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsPageTurnInverted, Mode=OneWay}"
                            Command="{Binding TogglePageTurnInversionCommand}" />
              <ToggleButton Content="{Binding PageLayoutLabel}"
                            Classes="filterChip"
                            Margin="0,0,6,6"
                            IsChecked="{Binding IsTwoPageMode, Mode=OneWay}"
                            Command="{Binding ToggleTwoPageModeCommand}" />
              <ToggleButton Content="Previous opens at end"
                            Classes="filterChip"
                            Margin="0,0,6,6"
                            IsChecked="{Binding OpenPreviousChapterAtLastPage, Mode=OneWay}"
                            Command="{Binding ToggleOpenPreviousChapterAtLastPageCommand}" />
              <Button Margin="0,0,6,6"
                      Command="{Binding ResetReaderDefaultsCommand}"
                      ToolTip.Tip="Reset reader defaults"
                      Classes="iconButton">
                <PathIcon Data="M12,5V1L7,6L12,11V7C15.31,7 18,9.69 18,13A6,6 0,0 1,12 19C10.34,19 8.86,18.31 7.78,17.22L6.36,18.64C7.81,20.09 9.81,21 12,21A8,8 0,0 0,20 13A8,8 0,0 0,12 5Z"
                          Width="18"
                          Height="18" />
              </Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="MOUSE WHEEL"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton Content="Scroll"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelScrollAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="scroll" />
              <RadioButton Content="Pages"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelPageTurnAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="page" />
              <RadioButton Content="Zoom"
                           GroupName="WheelAction"
                           IsChecked="{Binding IsWheelZoomAction, Mode=OneWay}"
                           Command="{Binding SetReaderWheelActionCommand}"
                           CommandParameter="zoom" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="TONE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <WrapPanel>
              <RadioButton Content="Original"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneOriginal, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="original" />
              <RadioButton Content="Warm"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneWarm, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="warm" />
              <RadioButton Content="Paper"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderTonePaper, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="paper" />
              <RadioButton Content="Cool"
                           GroupName="Tone"
                           Margin="0,0,8,6"
                           IsChecked="{Binding IsReaderToneCool, Mode=OneWay}"
                           Command="{Binding SetReaderColorToneCommand}"
                           CommandParameter="cool" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Text="PAGE ANIMATION"
                       FontSize="10"
                       FontWeight="SemiBold"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton Content="None"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationNone, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="none" />
              <RadioButton Content="Fade"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationFade, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="fade" />
              <RadioButton Content="Slide"
                           GroupName="Animation"
                           IsChecked="{Binding IsReaderAnimationSlide, Mode=OneWay}"
                           Command="{Binding SetReaderAnimationCommand}"
                           CommandParameter="slide" />
            </StackPanel>
          </StackPanel>

          <Button Command="{Binding ToggleReaderSettingsPanelCommand}"
                  Classes="iconButton"
                  ToolTip.Tip="Close Settings">
            <PathIcon Data="M18.3,5.71L12,12L18.3,18.29L16.89,19.7L10.59,13.41L4.29,19.7L2.88,18.29L9.17,12L2.88,5.71L4.29,4.3L10.59,10.59L16.89,4.3L18.3,5.71Z"
                      Width="18"
                      Height="18" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid RowDefinitions="Auto,*,Auto"
          IsVisible="{Binding !IsReaderSettingsPanelVisible}"
          Background="{Binding ReaderBackgroundBrush}">
      <Border Padding="12,7" Background="#DD000000">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock Text="{Binding ReaderStatus}"
                     Foreground="White"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsPageLoading}"
                       Width="80"
                       Height="3"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ComixaPrimaryBrush}" />
          <Button Grid.Column="2"
                  Command="{Binding ToggleReaderSettingsPanelCommand}"
                  IsVisible="{Binding HasSelectedBook}"
                  Classes="readerButton"
                  ToolTip.Tip="Reader settings"
                  Width="36"
                  Height="28"
                  Padding="0"
                  Margin="6,0">
            <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.02L21.54,9.37L19.54,5.91L17.05,6.91C16.53,6.5 15.96,6.16 15.34,5.9L14.96,3.25H10.96L10.58,5.9C9.96,6.16 9.39,6.5 8.87,6.91L6.38,5.91L4.38,9.37L6.5,11.02C6.45,11.33 6.42,11.66 6.42,12C6.42,12.34 6.45,12.66 6.5,12.98L4.38,14.63L6.38,18.09L8.87,17.09C9.39,17.5 9.96,17.84 10.58,18.1L10.96,20.75H14.96L15.34,18.1C15.96,17.84 16.53,17.5 17.05,17.09L19.54,18.09L21.54,14.63L19.43,12.98M12.96,15.5A3.5,3.5 0,1 1,12.96 8.5A3.5,3.5 0,0 1,12.96 15.5Z"
                      Width="16"
                      Height="16" />
          </Button>
          <TextBlock Grid.Column="3"
                     Text="{Binding CurrentPageLabel}"
                     Foreground="#D0FFFFFF"
                     VerticalAlignment="Center"
                     MinWidth="80"
                     TextAlignment="Right" />
        </Grid>
      </Border>

      <Grid x:Name="ReaderPageHost"
            Grid.Row="1"
            IsVisible="{Binding !IsVerticalMode}"
            Background="Transparent">
        <Grid IsVisible="{Binding IsFitPageMode}"
              ClipToBounds="True"
              Margin="20">
          <Grid x:Name="FitPageSurface">
            <Viewbox IsVisible="{Binding IsSinglePageVisible}"
                     Stretch="Uniform"
                     RenderTransformOrigin="0.5,0.5">
              <Viewbox.RenderTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </Viewbox.RenderTransform>
              <Grid>
                <Image Source="{Binding CurrentPageImage}"
                       Stretch="None" />
                <Border Background="{Binding ReaderPageTintBrush}"
                        IsVisible="{Binding IsReaderTintVisible}"
                        IsHitTestVisible="False" />
              </Grid>
            </Viewbox>

            <Viewbox IsVisible="{Binding IsTwoPageVisible}"
                     Stretch="Uniform"
                     RenderTransformOrigin="0.5,0.5">
              <Viewbox.RenderTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </Viewbox.RenderTransform>
              <Grid ColumnDefinitions="Auto,Auto">
                <Grid>
                  <Image Source="{Binding CurrentPageImage}"
                         Stretch="None" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
                <Grid Grid.Column="1"
                      IsVisible="{Binding HasNextPageImage}">
                  <Image Source="{Binding NextPageImage}"
                         Stretch="None" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
              </Grid>
            </Viewbox>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding !HasSelectedBook}">
              <TextBlock Text="Select a book to start reading"
                         Foreground="White"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Click a comic in the library or use the keyboard to navigate"
                         Foreground="#A0FFFFFF"
                         TextWrapping="Wrap"
                         MaxWidth="320"
                         TextAlignment="Center"
                         FontSize="12" />
            </StackPanel>
          </Grid>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsFitWidthMode}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <LayoutTransformControl HorizontalAlignment="Stretch"
                                    IsVisible="{Binding IsSinglePageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid>
                <Image Source="{Binding CurrentPageImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch" />
                <Border Background="{Binding ReaderPageTintBrush}"
                        IsVisible="{Binding IsReaderTintVisible}"
                        IsHitTestVisible="False" />
              </Grid>
            </LayoutTransformControl>

            <LayoutTransformControl HorizontalAlignment="Stretch"
                                    IsVisible="{Binding IsTwoPageVisible}">
              <LayoutTransformControl.LayoutTransform>
                <media:ScaleTransform ScaleX="{Binding ReaderZoom}" ScaleY="{Binding ReaderZoom}" />
              </LayoutTransformControl.LayoutTransform>
              <Grid ColumnDefinitions="*,*">
                <Grid>
                  <Image Source="{Binding CurrentPageImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Stretch" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
                <Grid Grid.Column="1"
                      IsVisible="{Binding HasNextPageImage}">
                  <Image Source="{Binding NextPageImage}"
                         Stretch="Uniform"
                         HorizontalAlignment="Stretch" />
                  <Border Background="{Binding ReaderPageTintBrush}"
                          IsVisible="{Binding IsReaderTintVisible}"
                          IsHitTestVisible="False" />
                </Grid>
              </Grid>
            </LayoutTransformControl>
          </Grid>
        </ScrollViewer>
      </Grid>

      <ListBox Grid.Row="1"
               ItemsSource="{Binding VerticalPages}"
               IsVisible="{Binding IsVerticalMode}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               Classes="verticalReaderList"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel CacheLength="0.5" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReaderPageViewModel">
            <Border AttachedToVisualTree="OnVerticalPageAttached"
                    DetachedFromVisualTree="OnVerticalPageDetached"
                    HorizontalAlignment="Center"
                    MaxWidth="980"
                    Margin="0,4"
                    ClipToBounds="True">
              <Grid>
                <Image Source="{Binding Image}"
                       Stretch="Uniform"
                       IsVisible="{Binding HasImage}" />
                <Border MinHeight="360"
                        Background="#141B24"
                        BorderBrush="#2C3947"
                        BorderThickness="1"
                        IsVisible="{Binding IsLoading}">
                  <TextBlock Text="{Binding LoadingLabel}"
                             Foreground="#B9C5D4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <Border MinHeight="360"
                        Background="#1B1416"
                        BorderBrush="#6E3037"
                        BorderThickness="1"
                        IsVisible="{Binding HasFailed}">
                  <TextBlock Text="Page could not be loaded"
                             Foreground="#FFB4BD"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" Padding="12,9" Background="#DD000000">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <Button Command="{Binding PreviousPageCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="Previous page"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M15.41,7.41L14,6L8,12L14,18L15.41,16.59L10.83,12L15.41,7.41Z"
                        Width="18"
                        Height="18" />
            </Button>
            <Button Command="{Binding OpenPreviousSeriesBookCommand}"
                    IsVisible="{Binding HasPreviousSeriesBookPrompt}"
                    Classes="readerPrimaryButton"
                    ToolTip.Tip="{Binding PreviousSeriesBookActionLabel}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M6,6H8V18H6V6M9.5,12L18,6V18L9.5,12Z"
                        Width="18"
                        Height="18" />
            </Button>
            <Button Command="{Binding NextPageCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="Next page"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z"
                        Width="18"
                        Height="18" />
            </Button>
            <Button Command="{Binding OpenNextSeriesBookCommand}"
                    IsVisible="{Binding HasNextSeriesBookPrompt}"
                    Classes="readerPrimaryButton"
                    ToolTip.Tip="{Binding NextSeriesBookActionLabel}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M16,6H18V18H16V6M6,18V6L14.5,12L6,18Z"
                        Width="18"
                        Height="18" />
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="1"
                     Text="{Binding CurrentPageLabel}"
                     Foreground="White"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding ZoomLabel}"
                       Foreground="#B8FFFFFF"
                       VerticalAlignment="Center"
                       FontSize="12" />

            <Button Command="{Binding ToggleBookmarkCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="{Binding BookmarkIcon}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M17,3H7C5.9,3 5,3.9 5,5V21L12,18L19,21V5C19,3.9 18.1,3 17,3Z"
                        Width="17"
                        Height="17" />
            </Button>

            <Button Command="{Binding ToggleFitModeCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="{Binding FitModeLabel}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M3,5V19H21V5H3M19,17H5V7H19V17M7,9H12V11H9V14H7V9M17,15H12V13H15V10H17V15Z"
                        Width="18"
                        Height="18" />
            </Button>

            <Button Command="{Binding ToggleTwoPageModeCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="{Binding PageLayoutLabel}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M3,5H11V19H3V5M13,5H21V19H13V5Z"
                        Width="18"
                        Height="18" />
            </Button>

            <Button Command="{Binding ToggleReaderFullscreenCommand}"
                    Classes="readerButton"
                    ToolTip.Tip="{Binding ReaderFullscreenLabel}"
                    Width="38"
                    Height="34"
                    Padding="0">
              <PathIcon Data="M5,5H10V3H3V10H5V5M5,14H3V21H10V19H5V14M19,19H14V21H21V14H19V19M14,3V5H19V10H21V3H14Z"
                        Width="18"
                        Height="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
