<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Comixa.Desktop.ViewModels"
        xmlns:views="using:Comixa.Desktop.Views"
        x:Class="Comixa.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Width="1360"
        Height="840"
        MinWidth="1000"
        MinHeight="640"
        Background="{DynamicResource ComixaBackgroundBrush}">

  <Grid RowDefinitions="52,*">
    <Border Background="{DynamicResource ComixaSurfaceBrush}"
            BorderBrush="{DynamicResource ComixaOutlineBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="20,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Comixa"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaPrimaryBrush}" />
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="11"
                     Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="chromeButton"
                Content="{Binding ReaderPreviewPaneLabel}"
                Command="{Binding ToggleReaderPreviewPaneCommand}"
                ToolTip.Tip="Show or hide the reader preview pane"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Classes="chromeButton"
                Content="{Binding ReaderFullscreenLabel}"
                Command="{Binding ToggleReaderFullscreenCommand}"
                IsVisible="{Binding HasSelectedBook}"
                ToolTip.Tip="Fullscreen reader (F11)"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
        <Button Grid.Column="3"
                Classes="chromeButton"
                Content="{Binding ThemeToggleLabel}"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Toggle light/dark theme"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
        <Button Grid.Column="4"
                Classes="chromeButton"
                Content="Settings"
                Command="{Binding ToggleSettingsPanelCommand}"
                ToolTip.Tip="Settings (S)"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="{Binding LibraryPaneWidth}" />
        <ColumnDefinition Width="{Binding ReaderPreviewSplitterWidth}" />
        <ColumnDefinition Width="{Binding ReaderPreviewPaneWidth}" />
      </Grid.ColumnDefinitions>
      <views:SidebarView />
      <Border Grid.Column="1" Background="{DynamicResource ComixaOutlineBrush}" />
      <views:LibraryPaneView Grid.Column="2" />
      <GridSplitter Grid.Column="3"
                    IsVisible="{Binding IsReaderPreviewPaneEnabled}"
                    Background="{DynamicResource ComixaOutlineBrush}"
                    ResizeDirection="Columns" />
      <views:ReaderPaneView Grid.Column="4"
                            IsVisible="{Binding IsReaderPreviewPaneEnabled}" />
    </Grid>

    <Border Grid.RowSpan="2"
            Background="{Binding ReaderBackgroundBrush}"
            IsVisible="{Binding IsReaderFullscreen}">
      <views:ReaderPaneView />
    </Border>
  </Grid>
</Window>
