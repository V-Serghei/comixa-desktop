<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Comixa.Desktop.ViewModels"
        xmlns:views="using:Comixa.Desktop.Views"
        x:Class="Comixa.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Icon="/Assets/comixa.ico"
        Title="{Binding Title}"
        Width="1360"
        Height="840"
        MinWidth="1000"
        MinHeight="640"
        Background="{DynamicResource ComixaBackgroundBrush}">

  <Grid RowDefinitions="60,*">
    <Border Background="{DynamicResource ComixaSurfaceBrush}"
            BorderBrush="{DynamicResource ComixaOutlineBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="22,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Comixa"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaPrimaryBrush}" />
          <TextBlock Text="{Binding LibraryStatsLabel}"
                     FontSize="11"
                     Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="iconButton"
                Command="{Binding ToggleReaderPreviewPaneCommand}"
                ToolTip.Tip="{Binding ReaderPreviewPaneLabel}"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
          <PathIcon Data="M3,5H21V19H3V5M5,7V17H12V7H5M14,7V17H19V7H14Z"
                    Width="18"
                    Height="18" />
        </Button>
        <Button Grid.Column="2"
                Classes="iconButton"
                Command="{Binding ToggleReaderFullscreenCommand}"
                IsVisible="{Binding HasSelectedBook}"
                ToolTip.Tip="{Binding ReaderFullscreenLabel}"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
          <PathIcon Data="M5,5H10V3H3V10H5V5M5,14H3V21H10V19H5V14M19,19H14V21H21V14H19V19M14,3V5H19V10H21V3H14Z"
                    Width="18"
                    Height="18" />
        </Button>
        <Button Grid.Column="3"
                Classes="iconButton"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="{Binding ThemeToggleLabel}"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
          <PathIcon Data="{Binding ThemeIcon}"
                    Width="17"
                    Height="17" />
        </Button>
        <Button Grid.Column="4"
                Classes="iconButton"
                Command="{Binding ToggleSettingsPanelCommand}"
                ToolTip.Tip="Settings (S)"
                VerticalAlignment="Center">
          <PathIcon Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.33 19.42,11.02L21.54,9.37L19.54,5.91L17.05,6.91C16.53,6.5 15.96,6.16 15.34,5.9L14.96,3.25H10.96L10.58,5.9C9.96,6.16 9.39,6.5 8.87,6.91L6.38,5.91L4.38,9.37L6.5,11.02C6.45,11.33 6.42,11.66 6.42,12C6.42,12.34 6.45,12.66 6.5,12.98L4.38,14.63L6.38,18.09L8.87,17.09C9.39,17.5 9.96,17.84 10.58,18.1L10.96,20.75H14.96L15.34,18.1C15.96,17.84 16.53,17.5 17.05,17.09L19.54,18.09L21.54,14.63L19.43,12.98M12.96,15.5A3.5,3.5 0,1 1,12.96 8.5A3.5,3.5 0,0 1,12.96 15.5Z"
                    Width="18"
                    Height="18" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="{Binding LibraryPaneWidth}" />
        <ColumnDefinition Width="{Binding ReaderPreviewSplitterWidth}" />
        <ColumnDefinition Width="{Binding ReaderPreviewPaneWidth}" />
      </Grid.ColumnDefinitions>
      <views:SidebarView />
      <Border Grid.Column="1" Background="{DynamicResource ComixaOutlineBrush}" />
      <views:LibraryPaneView Grid.Column="2" />
      <GridSplitter Grid.Column="3"
                    IsVisible="{Binding IsReaderPreviewPaneEnabled}"
                    Background="{DynamicResource ComixaOutlineBrush}"
                    ResizeDirection="Columns" />
      <views:ReaderPaneView Grid.Column="4"
                            IsVisible="{Binding IsReaderPreviewPaneEnabled}" />
    </Grid>

    <Border Grid.RowSpan="2"
            Background="{Binding ReaderBackgroundBrush}"
            IsVisible="{Binding IsReaderFullscreen}">
      <views:ReaderPaneView />
    </Border>

    <Border Grid.RowSpan="2"
            IsVisible="{Binding IsSettingsPanelVisible}"
            Background="#B0000000">
      <Border Width="820"
              MaxHeight="720"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              CornerRadius="8"
              Background="{DynamicResource ComixaSurfaceBrush}"
              BorderBrush="{DynamicResource ComixaOutlineBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="24,20"
                  BorderBrush="{DynamicResource ComixaOutlineBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Settings"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="iconButton"
                      Command="{Binding ToggleSettingsPanelCommand}"
                      ToolTip.Tip="Close"
                      VerticalAlignment="Center">
                <PathIcon Data="M18.3,5.71L12,12L18.3,18.29L16.89,19.7L10.59,13.41L4.29,19.7L2.88,18.29L9.17,12L2.88,5.71L4.29,4.3L10.59,10.59L16.89,4.3L18.3,5.71Z"
                          Width="18"
                          Height="18" />
              </Button>
            </Grid>
          </Border>

          <Grid Grid.Row="1" ColumnDefinitions="190,*">
            <Border Background="{DynamicResource ComixaSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource ComixaOutlineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14">
              <StackPanel Spacing="8">
                <ToggleButton Content="Application"
                              Classes="settingsTabButton"
                              IsChecked="{Binding IsSettingsApplicationTab, Mode=OneWay}"
                              Command="{Binding SetSettingsTabCommand}"
                              CommandParameter="application" />
                <ToggleButton Content="Library"
                              Classes="settingsTabButton"
                              IsChecked="{Binding IsSettingsLibraryTab, Mode=OneWay}"
                              Command="{Binding SetSettingsTabCommand}"
                              CommandParameter="library" />
                <ToggleButton Content="Reader"
                              Classes="settingsTabButton"
                              IsChecked="{Binding IsSettingsReaderTab, Mode=OneWay}"
                              Command="{Binding SetSettingsTabCommand}"
                              CommandParameter="reader" />

                <Border Height="1"
                        Background="{DynamicResource ComixaOutlineBrush}"
                        Margin="0,10" />

                <TextBlock Text="{Binding ActivityStatsLabel}"
                           FontSize="12"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="26" Spacing="26">
                <StackPanel Spacing="22" IsVisible="{Binding IsSettingsApplicationTab}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Appearance"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <WrapPanel>
                      <ToggleButton Content="Dark theme"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                    Command="{Binding ToggleThemeCommand}" />
                      <ToggleButton Content="{Binding ReaderPreviewPaneLabel}"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsReaderPreviewPaneEnabled, Mode=OneWay}"
                                    Command="{Binding ToggleReaderPreviewPaneCommand}" />
                    </WrapPanel>
                  </StackPanel>

                  <Border Height="1" Background="{DynamicResource ComixaOutlineBrush}" />

                  <StackPanel Spacing="8">
                    <TextBlock Text="Startup"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <WrapPanel>
                      <ToggleButton Content="Resume reading position"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding OpenComicsAtLastPosition, Mode=OneWay}"
                                    Command="{Binding ToggleOpenComicsAtLastPositionCommand}" />
                      <ToggleButton Content="Open fullscreen"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding OpenComicsInFullscreen, Mode=OneWay}"
                                    Command="{Binding ToggleOpenComicsInFullscreenCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="20" IsVisible="{Binding IsSettingsLibraryTab}">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Library"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                      <TextBlock Text="{Binding FolderStatsLabel}"
                                 FontSize="12"
                                 Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="iconButton"
                            Command="{Binding ScanFolderCommand}"
                            ToolTip.Tip="Add Folder"
                            Margin="0,0,8,0">
                      <PathIcon Data="M10,4L12,6H20C21.1,6 22,6.9 22,8V18C22,19.1 21.1,20 20,20H4C2.9,20 2,19.1 2,18V6C2,4.9 2.9,4 4,4H10M19,13H16V10H14V13H11V15H14V18H16V15H19V13Z"
                                Width="18"
                                Height="18" />
                    </Button>
                    <Button Grid.Column="2"
                            Classes="iconButton"
                            Command="{Binding RefreshLibraryCommand}"
                            ToolTip.Tip="Refresh">
                      <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0,0 0,4,12A8,8 0,0 0,12 20C15.73,20 18.84,17.45 19.73,14H17.65C16.82,16.33 14.61,18 12,18A6,6 0,0 1,6 12A6,6 0,0 1,12 6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                Width="18"
                                Height="18" />
                    </Button>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding LibraryFolders}" IsVisible="{Binding HasLibraryFolders}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryFolderViewModel">
                        <Border BorderBrush="{DynamicResource ComixaOutlineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,10">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                              <TextBlock Text="{Binding Path}"
                                         FontSize="11"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CountLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0" />
                            <Button Grid.Column="2"
                                    Classes="iconDangerButton"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="Remove folder"
                                    VerticalAlignment="Center">
                              <PathIcon Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"
                                        Width="16"
                                        Height="16" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="No watched folders"
                             IsVisible="{Binding !HasLibraryFolders}"
                             Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />

                  <Border Height="1" Background="{DynamicResource ComixaOutlineBrush}" />

                  <StackPanel Spacing="10">
                    <TextBlock Text="Recent comics"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <ItemsControl ItemsSource="{Binding ActivityItems}" IsVisible="{Binding HasActivity}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityItemViewModel">
                          <Grid ColumnDefinitions="64,*" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TimeLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                              <TextBlock Text="{Binding Detail}"
                                         IsVisible="{Binding HasDetail}"
                                         FontSize="11"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="22" IsVisible="{Binding IsSettingsReaderTab}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Reading direction"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <WrapPanel>
                      <RadioButton Content="Left to Right"
                                   GroupName="SettingsDirection"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsLeftToRight, Mode=OneWay}"
                                   Command="{Binding SetReadingDirectionCommand}"
                                   CommandParameter="ltr" />
                      <RadioButton Content="Right to Left"
                                   GroupName="SettingsDirection"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsRightToLeft, Mode=OneWay}"
                                   Command="{Binding SetReadingDirectionCommand}"
                                   CommandParameter="rtl" />
                      <RadioButton Content="Top to Bottom"
                                   GroupName="SettingsDirection"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsTopToBottom, Mode=OneWay}"
                                   Command="{Binding SetReadingDirectionCommand}"
                                   CommandParameter="ttb" />
                    </WrapPanel>
                  </StackPanel>

                  <Border Height="1" Background="{DynamicResource ComixaOutlineBrush}" />

                  <StackPanel Spacing="8">
                    <TextBlock Text="Reader behavior"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <WrapPanel>
                      <ToggleButton Content="{Binding PageLayoutLabel}"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsTwoPageMode, Mode=OneWay}"
                                    Command="{Binding ToggleTwoPageModeCommand}" />
                      <ToggleButton Content="Edge page turns"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsEdgePageTurnEnabled, Mode=OneWay}"
                                    Command="{Binding ToggleEdgePageTurnsCommand}" />
                      <ToggleButton Content="Drag page turns"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsDragPageTurnEnabled, Mode=OneWay}"
                                    Command="{Binding ToggleDragPageTurnsCommand}" />
                      <ToggleButton Content="Invert turns"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding IsPageTurnInverted, Mode=OneWay}"
                                    Command="{Binding TogglePageTurnInversionCommand}" />
                      <ToggleButton Content="Previous opens at end"
                                    Classes="filterChip"
                                    Margin="0,0,8,8"
                                    IsChecked="{Binding OpenPreviousChapterAtLastPage, Mode=OneWay}"
                                    Command="{Binding ToggleOpenPreviousChapterAtLastPageCommand}" />
                    </WrapPanel>
                  </StackPanel>

                  <Border Height="1" Background="{DynamicResource ComixaOutlineBrush}" />

                  <StackPanel Spacing="8">
                    <TextBlock Text="Wheel"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                    <WrapPanel>
                      <RadioButton Content="Scroll"
                                   GroupName="SettingsWheel"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsWheelScrollAction, Mode=OneWay}"
                                   Command="{Binding SetReaderWheelActionCommand}"
                                   CommandParameter="scroll" />
                      <RadioButton Content="Pages"
                                   GroupName="SettingsWheel"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsWheelPageTurnAction, Mode=OneWay}"
                                   Command="{Binding SetReaderWheelActionCommand}"
                                   CommandParameter="page" />
                      <RadioButton Content="Zoom"
                                   GroupName="SettingsWheel"
                                   Margin="0,0,12,8"
                                   IsChecked="{Binding IsWheelZoomAction, Mode=OneWay}"
                                   Command="{Binding SetReaderWheelActionCommand}"
                                   CommandParameter="zoom" />
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="iconButton"
                            Command="{Binding ResetReaderDefaultsCommand}"
                            ToolTip.Tip="Reset reader defaults">
                      <PathIcon Data="M12,5V1L7,6L12,11V7C15.31,7 18,9.69 18,13A6,6 0,0 1,12 19C10.34,19 8.86,18.31 7.78,17.22L6.36,18.64C7.81,20.09 9.81,21 12,21A8,8 0,0 0,20 13A8,8 0,0 0,12 5Z"
                                Width="18"
                                Height="18" />
                    </Button>
                    <Button Classes="iconButton"
                            Command="{Binding ToggleReaderSettingsPanelCommand}"
                            ToolTip.Tip="Open reader panel">
                      <PathIcon Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"
                                Width="18"
                                Height="18" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
