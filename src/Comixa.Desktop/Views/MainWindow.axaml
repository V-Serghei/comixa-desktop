<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Comixa.Desktop.ViewModels"
        x:Class="Comixa.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="{Binding Title}"
        Width="1360"
        Height="840"
        MinWidth="1000"
        MinHeight="640"
        Background="{DynamicResource ComixaBackgroundBrush}">

  <!-- ─── Keyboard shortcuts ─────────────────────────────────────── -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Left"     Command="{Binding PageBackwardCommand}" />
    <KeyBinding Gesture="Right"    Command="{Binding PageForwardCommand}" />
    <KeyBinding Gesture="Up"       Command="{Binding PageBackwardCommand}" />
    <KeyBinding Gesture="Down"     Command="{Binding PageForwardCommand}" />
    <KeyBinding Gesture="PageUp"   Command="{Binding PageBackwardCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding PageForwardCommand}" />
    <KeyBinding Gesture="Home"     Command="{Binding GoToFirstPageCommand}" />
    <KeyBinding Gesture="End"      Command="{Binding GoToLastPageCommand}" />
    <KeyBinding Gesture="F"        Command="{Binding ToggleFitModeCommand}" />
    <KeyBinding Gesture="B"        Command="{Binding ToggleBookmarkCommand}" />
    <KeyBinding Gesture="S"        Command="{Binding ToggleSettingsPanelCommand}" />
  </Window.KeyBindings>

  <!-- ─── Book card DataTemplates ──────────────────────────────────── -->
  <Window.DataTemplates>

    <!-- Single book card (100 × ~200) -->
    <DataTemplate x:DataType="vm:SingleLibraryItemViewModel">
      <Button Command="{Binding OpenCommand}"
              Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
            <Separator />
            <MenuItem Header="Mark as Read" Command="{Binding MarkAsReadCommand}" />
            <MenuItem Header="Mark as Unread" Command="{Binding MarkAsUnreadCommand}" />
            <Separator />
            <MenuItem Header="Add to shelf..." ItemsSource="{Binding ShelfItems}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem">
                  <Setter Property="Header" Value="{ReflectionBinding MenuText}" />
                  <Setter Property="Command" Value="{ReflectionBinding ToggleCommand}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
          </ContextMenu>
        </Button.ContextMenu>
        <Panel>
          <Border Width="100" Background="{DynamicResource ComixaSurfaceBrush}"
                  BorderBrush="{DynamicResource ComixaOutlineBrush}" BorderThickness="1"
                  CornerRadius="7" ClipToBounds="True">
            <Grid RowDefinitions="130,Auto,3">
              <!-- Cover -->
              <Border Background="{DynamicResource ComixaSurfaceVariantBrush}">
                <Grid>
                  <Image Source="{Binding Item.CoverImage}" Stretch="UniformToFill"
                         IsVisible="{Binding Item.HasCoverImage}" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                              IsVisible="{Binding !Item.HasCoverImage}">
                    <TextBlock Text="{Binding Item.Format}"
                               Foreground="{DynamicResource ComixaPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  </StackPanel>
                  <!-- Started / read indicator -->
                  <Border IsVisible="{Binding Item.HasProgress}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Background="{DynamicResource ComixaPrimaryBrush}"
                          CornerRadius="0,3,0,0" Padding="4,2">
                    <TextBlock Text="{Binding Item.ReadStatusLabel}"
                               FontSize="8" FontWeight="Bold" Foreground="#001B12" />
                  </Border>
                </Grid>
              </Border>
              <!-- Info -->
              <StackPanel Grid.Row="1" Margin="6,5,6,5">
                <TextBlock Text="{Binding Item.Title}"
                           Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Item.Metadata}"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                           FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <!-- Progress bar -->
              <ProgressBar Grid.Row="2" Value="{Binding Item.ProgressValue}" Maximum="1.0"
                           IsVisible="{Binding Item.HasProgress}"
                           Foreground="{DynamicResource ComixaPrimaryBrush}"
                           Background="{DynamicResource ComixaOutlineBrush}" />
            </Grid>
          </Border>
          <!-- "Currently open" accent overlay -->
          <Border Width="100" BorderBrush="{DynamicResource ComixaPrimaryBrush}" BorderThickness="2"
                  CornerRadius="7" IsVisible="{Binding IsCurrentlyOpen}" />
        </Panel>
      </Button>
    </DataTemplate>

    <!-- Series card (100 × ~200) -->
    <DataTemplate x:DataType="vm:SeriesLibraryItemViewModel">
      <Button Command="{Binding OpenCommand}"
              Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
        <Border Width="100" Background="{DynamicResource ComixaSurfaceBrush}"
                BorderBrush="{DynamicResource ComixaOutlineBrush}" BorderThickness="1"
                CornerRadius="7" ClipToBounds="True">
          <Grid RowDefinitions="130,Auto,3">
            <Panel Background="{DynamicResource ComixaSurfaceVariantBrush}">
              <Image Source="{Binding Cover.CoverImage}" Stretch="UniformToFill"
                     IsVisible="{Binding Cover.HasCoverImage}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                          IsVisible="{Binding !Cover.HasCoverImage}">
                <TextBlock Text="📚" FontSize="24" HorizontalAlignment="Center" />
              </StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                      Background="{DynamicResource ComixaPrimaryBrush}"
                      CornerRadius="0,0,0,5" Padding="4,2">
                <TextBlock Text="{Binding IssueCountLabel}"
                           FontSize="8" FontWeight="Bold" Foreground="#001B12" />
              </Border>
            </Panel>
            <StackPanel Grid.Row="1" Margin="6,5,6,5">
              <TextBlock Text="{Binding SeriesName}"
                         Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                         FontSize="10" FontWeight="SemiBold"
                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding IssueCountLabel}"
                         Foreground="{DynamicResource ComixaSecondaryBrush}"
                         FontSize="9" Margin="0,1,0,0" />
            </StackPanel>
            <ProgressBar Grid.Row="2" Value="{Binding ProgressValue}" Maximum="1.0"
                         IsVisible="{Binding HasProgress}"
                         Foreground="{DynamicResource ComixaSecondaryBrush}"
                         Background="{DynamicResource ComixaOutlineBrush}" />
          </Grid>
        </Border>
      </Button>
    </DataTemplate>

  </Window.DataTemplates>

  <Grid RowDefinitions="52,*">

    <!-- ─── Top bar ──────────────────────────────────────────────── -->
    <Border Background="{DynamicResource ComixaSurfaceBrush}"
            BorderBrush="{DynamicResource ComixaOutlineBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="20,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Comixa" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaPrimaryBrush}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                     Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="+ Add Folder"
                  Command="{Binding ScanFolderCommand}"
                  Background="{DynamicResource ComixaPrimaryBrush}"
                  Foreground="#001B12" />
          <Button Content="⚙"
                  Command="{Binding ToggleSettingsPanelCommand}"
                  ToolTip.Tip="Settings (S)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ─── Body ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="168,1,340,4,*">

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── Sidebar (col 0) ──────────────────────────────────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <Border Background="{DynamicResource ComixaSurfaceBrush}"
              BorderBrush="{DynamicResource ComixaOutlineBrush}" BorderThickness="0,0,0,0">
        <Grid RowDefinitions="*,Auto">

          <!-- Scrollable nav area -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,8,0,8">

              <!-- ── LIBRARY section ── -->
              <TextBlock Text="LIBRARY" Margin="16,8,0,6"
                         FontSize="9" FontWeight="SemiBold" LetterSpacing="1.5"
                         Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />

              <Panel>
                <Border IsVisible="{Binding IsViewAllBooks}"
                        BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                        BorderThickness="3,0,0,0" CornerRadius="0" />
                <Button Command="{Binding NavigateToAllBooksCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,8" Margin="0,1" Background="Transparent" BorderThickness="0">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📚" FontSize="14" />
                    <TextBlock Text="All Books" FontSize="13"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                  </StackPanel>
                </Button>
              </Panel>

              <Panel>
                <Border IsVisible="{Binding IsViewSeries}"
                        BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                        BorderThickness="3,0,0,0" CornerRadius="0" />
                <Button Command="{Binding NavigateToSeriesCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="16,8" Margin="0,1" Background="Transparent" BorderThickness="0">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📖" FontSize="14" />
                    <TextBlock Text="Series" FontSize="13"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                  </StackPanel>
                </Button>
              </Panel>

              <!-- ── SHELVES section ── -->
              <Grid ColumnDefinitions="*,Auto" Margin="16,14,8,4">
                <TextBlock Text="SHELVES" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.5"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+"
                        Command="{Binding StartCreateShelfCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="4,2" FontSize="16"
                        Foreground="{DynamicResource ComixaPrimaryBrush}"
                        ToolTip.Tip="New shelf" />
              </Grid>

              <!-- New shelf input -->
              <Grid IsVisible="{Binding IsCreatingShelf}"
                    ColumnDefinitions="*,Auto,Auto" Margin="8,0,8,6">
                <TextBox Text="{Binding NewShelfName}"
                         PlaceholderText="Shelf name..." FontSize="12" />
                <Button Grid.Column="1" Content="✓"
                        Command="{Binding ConfirmNewShelfCommand}"
                        Background="{DynamicResource ComixaPrimaryBrush}"
                        Foreground="#001B12" Margin="4,0,0,0" Padding="6,4"
                        ToolTip.Tip="Create" />
                <Button Grid.Column="2" Content="✕"
                        Command="{Binding CancelNewShelfCommand}"
                        Background="Transparent" Margin="2,0,0,0" Padding="6,4"
                        ToolTip.Tip="Cancel" />
              </Grid>

              <!-- Shelf nav items -->
              <ItemsControl ItemsSource="{Binding Shelves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShelfViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,1">
                      <Button Command="{Binding SelectCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Padding="16,7" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="📂" FontSize="13" />
                          <TextBlock Text="{Binding Name}" FontSize="12"
                                     Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                     TextTrimming="CharacterEllipsis" MaxWidth="100" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Content="×"
                              Command="{Binding DeleteCommand}"
                              Background="Transparent" BorderThickness="0"
                              Padding="6,7" FontSize="13"
                              Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Delete shelf" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

          <!-- Bottom: theme toggle -->
          <Border Grid.Row="1"
                  BorderBrush="{DynamicResource ComixaOutlineBrush}" BorderThickness="0,1,0,0">
            <Button Command="{Binding ToggleThemeCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,10" Background="Transparent" BorderThickness="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="☀" FontSize="14" IsVisible="{Binding IsDarkTheme}" />
                <TextBlock Text="🌙" FontSize="14" IsVisible="{Binding IsLightTheme}" />
                <TextBlock Text="Light mode" FontSize="12" IsVisible="{Binding IsDarkTheme}"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                <TextBlock Text="Dark mode" FontSize="12" IsVisible="{Binding IsLightTheme}"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
              </StackPanel>
            </Button>
          </Border>

        </Grid>
      </Border>

      <!-- Sidebar divider -->
      <Border Grid.Column="1" Background="{DynamicResource ComixaOutlineBrush}" />

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── Library content (col 2) ──────────────────────────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12,10,12,0">

        <!-- Row 0: View title + search -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="{Binding LibraryViewTitle}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                     FontSize="10" Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- Row 1: Search -->
        <Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding SearchQuery}"
                   PlaceholderText="Search..." />
          <Button Grid.Column="1" Content="✕"
                  Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding HasSearchQuery}"
                  Background="Transparent" Margin="4,0,0,0" />
        </Grid>

        <!-- Row 2: Filter chips -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
          <ToggleButton Content="Unread" Margin="0,0,4,4"
                        IsChecked="{Binding ShowUnreadOnly, Mode=OneWay}"
                        Command="{Binding ToggleUnreadOnlyCommand}" />
          <ToggleButton Content="CBZ" Margin="0,0,4,4"
                        IsChecked="{Binding IsCbzFilterActive, Mode=OneWay}"
                        Command="{Binding ToggleCbzFilterCommand}" />
          <ToggleButton Content="ZIP" Margin="0,0,4,4"
                        IsChecked="{Binding IsZipFilterActive, Mode=OneWay}"
                        Command="{Binding ToggleZipFilterCommand}" />
          <ToggleButton Content="PDF" Margin="0,0,4,4"
                        IsChecked="{Binding IsPdfFilterActive, Mode=OneWay}"
                        Command="{Binding TogglePdfFilterCommand}" />
        </WrapPanel>

        <!-- Row 3: Sort -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
          <TextBlock Text="Sort:" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
          <RadioButton Content="A–Z" GroupName="Sort"
                       IsChecked="{Binding IsSortTitleAsc, Mode=OneWay}"
                       Command="{Binding SetSortOrderCommand}" CommandParameter="title_asc" />
          <RadioButton Content="Z–A" GroupName="Sort"
                       IsChecked="{Binding IsSortTitleDesc, Mode=OneWay}"
                       Command="{Binding SetSortOrderCommand}" CommandParameter="title_desc" />
          <RadioButton Content="Added" GroupName="Sort"
                       IsChecked="{Binding IsSortRecentlyAdded, Mode=OneWay}"
                       Command="{Binding SetSortOrderCommand}" CommandParameter="recent_added" />
          <RadioButton Content="Read" GroupName="Sort"
                       IsChecked="{Binding IsSortRecentlyRead, Mode=OneWay}"
                       Command="{Binding SetSortOrderCommand}" CommandParameter="recent_read" />
        </StackPanel>

        <!-- Row 4: Content -->
        <Grid Grid.Row="4">

          <!-- Main library grid -->
          <Grid IsVisible="{Binding !IsInSeriesDetail}">
            <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
              <TextBlock Text="📚" FontSize="44" HorizontalAlignment="Center" />
              <TextBlock Text="No comics here yet"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
              <TextBlock Text="Use + Add Folder to scan your local comics"
                         TextAlignment="Center" Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                         FontSize="11" TextWrapping="Wrap" MaxWidth="240" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsLibraryEmpty}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding DisplayedItems}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

          <!-- Series detail -->
          <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsInSeriesDetail}">
            <Button Grid.Row="0" Content="← Back"
                    Command="{Binding BackToLibraryCommand}"
                    Background="Transparent"
                    Foreground="{DynamicResource ComixaPrimaryBrush}"
                    HorizontalAlignment="Left" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="{Binding CurrentSeriesName}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                       Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SeriesBooks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding $parent[ItemsControl].DataContext.OpenBookCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Cursor="Hand">
                      <Border Padding="8,6"
                              Background="{DynamicResource ComixaSurfaceVariantBrush}"
                              CornerRadius="5" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,3" ColumnDefinitions="52,*">
                          <Border CornerRadius="3" Width="46" Height="60"
                                  Background="{DynamicResource ComixaOutlineBrush}">
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasCoverImage}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                      Margin="8,0" Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                       FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Metadata}"
                                       Foreground="{DynamicResource ComixaPrimaryBrush}"
                                       FontSize="9.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ReadStatusLabel}"
                                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                       FontSize="9" IsVisible="{Binding HasProgress}" />
                          </StackPanel>
                          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                       Value="{Binding ProgressValue}" Maximum="1.0"
                                       IsVisible="{Binding HasProgress}"
                                       Foreground="{DynamicResource ComixaPrimaryBrush}"
                                       Background="{DynamicResource ComixaOutlineBrush}"
                                       Height="3" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>

        </Grid>
      </Grid>

      <!-- ── GridSplitter (col 3) ──────────────────────────────── -->
      <GridSplitter Grid.Column="3"
                    Background="{DynamicResource ComixaOutlineBrush}"
                    ResizeDirection="Columns" />

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── Reader panel (col 4) ──────────────────────────────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <Grid Grid.Column="4" x:Name="ReaderGrid">

        <!-- Settings overlay -->
        <Border IsVisible="{Binding IsSettingsPanelVisible}"
                Background="{DynamicResource ComixaSurfaceBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="40">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                         Foreground="{DynamicResource ComixaOnSurfaceBrush}" />

              <StackPanel Spacing="10">
                <TextBlock Text="READING DIRECTION" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                <StackPanel Spacing="8">
                  <RadioButton Content="Left → Right  (Western comics)" GroupName="Direction"
                               IsChecked="{Binding IsLeftToRight, Mode=OneWay}"
                               Command="{Binding SetReadingDirectionCommand}" CommandParameter="ltr" />
                  <RadioButton Content="Right ← Left  (Manga)" GroupName="Direction"
                               IsChecked="{Binding IsRightToLeft, Mode=OneWay}"
                               Command="{Binding SetReadingDirectionCommand}" CommandParameter="rtl" />
                  <RadioButton Content="Top ↓ Bottom  (Webtoon / vertical scroll)" GroupName="Direction"
                               IsChecked="{Binding IsTopToBottom, Mode=OneWay}"
                               Command="{Binding SetReadingDirectionCommand}" CommandParameter="ttb" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                <TextBlock Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" FontSize="12"
                           Text="← → ↑ ↓  —  navigate pages&#xA;Page Up / Down  —  navigate pages&#xA;Home / End  —  first / last page&#xA;F  —  Fit Page / Fit Width&#xA;B  —  toggle bookmark&#xA;S  —  settings&#xA;Right-click card  —  mark read / shelves" />
              </StackPanel>

              <Button Content="Close Settings"
                      Command="{Binding ToggleSettingsPanelCommand}"
                      Background="{DynamicResource ComixaPrimaryBrush}"
                      Foreground="#001B12" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Reader -->
        <Grid RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding !IsSettingsPanelVisible}"
              Background="#000000">

          <!-- Reader header -->
          <Border Padding="12,7" Background="#DD000000">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding ReaderStatus}" Foreground="White"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <ProgressBar Grid.Column="1" IsIndeterminate="True"
                           IsVisible="{Binding IsPageLoading}"
                           Width="80" Height="3" Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ComixaPrimaryBrush}" />
              <TextBlock Grid.Column="2" Text="{Binding CurrentPageLabel}"
                         Foreground="#D0FFFFFF" VerticalAlignment="Center"
                         MinWidth="80" TextAlignment="Right" />
            </Grid>
          </Border>

          <!-- ─── Page area (horizontal) ─── -->
          <Grid Grid.Row="1" IsVisible="{Binding !IsVerticalMode}">
            <ScrollViewer IsVisible="{Binding IsFitPageMode}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Grid MinHeight="400">
                <Image Source="{Binding CurrentPageImage}" Stretch="Uniform"
                       Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasCurrentPageImage}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            IsVisible="{Binding !HasSelectedBook}">
                  <TextBlock Text="📖" FontSize="52" HorizontalAlignment="Center" />
                  <TextBlock Text="Select a book to start reading"
                             Foreground="White" FontSize="18" FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Click a comic in the library or press ← → to navigate"
                             Foreground="#A0FFFFFF" TextWrapping="Wrap" MaxWidth="320"
                             TextAlignment="Center" FontSize="12" />
                </StackPanel>
              </Grid>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsFitWidthMode}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Image Source="{Binding CurrentPageImage}" Stretch="Uniform"
                     HorizontalAlignment="Stretch" IsVisible="{Binding HasCurrentPageImage}" />
            </ScrollViewer>

            <!-- Click zones — custom template keeps Background="Transparent" hit-testable -->
            <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasCurrentPageImage}">
              <Button Grid.Column="0" Command="{Binding PageBackwardCommand}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Grid.Column="1" Command="{Binding PageForwardCommand}" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate>
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Grid>

          <!-- ─── Page area (vertical / webtoon) ─── -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsVerticalMode}"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VerticalPages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Image Source="{Binding}" Stretch="Uniform" Margin="0,2" MaxWidth="960" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- ─── Navigation footer ─── -->
          <Border Grid.Row="2" Padding="12,9" Background="#DD000000">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button Content="◀" Command="{Binding PreviousPageCommand}"
                        ToolTip.Tip="Previous page (← ↑)" />
                <Button Content="▶" Command="{Binding NextPageCommand}"
                        ToolTip.Tip="Next page (→ ↓)" />
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding CurrentPageLabel}"
                         Foreground="White" VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         FontSize="13" FontWeight="SemiBold" />

              <!-- Bookmark button -->
              <Button Grid.Column="2" Content="{Binding BookmarkIcon}"
                      Command="{Binding ToggleBookmarkCommand}"
                      Margin="0,0,6,0"
                      ToolTip.Tip="Toggle bookmark (B)" />

              <!-- Fit mode toggle -->
              <Button Grid.Column="3" Content="{Binding FitModeLabel}"
                      Command="{Binding ToggleFitModeCommand}"
                      ToolTip.Tip="Fit Page / Fit Width (F)" />
            </Grid>
          </Border>

        </Grid>
      </Grid>

    </Grid>
  </Grid>
</Window>
