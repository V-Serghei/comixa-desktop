<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Comixa.Desktop.ViewModels"
             x:Class="Comixa.Desktop.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <Border Background="{DynamicResource ComixaSurfaceElevatedBrush}">
    <Grid RowDefinitions="*">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,12,10,12" Spacing="16">
          <StackPanel Spacing="4" Margin="4,0,4,0">
            <TextBlock Text="Local library"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
            <TextBlock Text="{Binding LibraryStatsLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="LIBRARY"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarNavigationItemViewModel">
                  <Panel Margin="0,1">
                    <Border IsVisible="{Binding IsActive}"
                            BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3" />
                    <Button Command="{Binding Command}"
                            Classes="sidebarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="9,7"
                            BorderThickness="0"
                            ToolTip.Tip="{Binding ToolTip}"
                            Height="34">
                      <Grid ColumnDefinitions="22,*,Auto">
                        <PathIcon Data="{Binding Icon}"
                                  Width="15"
                                  Height="15"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Detail}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                   IsVisible="{Binding HasDetail}" />
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="STATUS"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding StatusNavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarNavigationItemViewModel">
                  <Panel Margin="0,1">
                    <Border IsVisible="{Binding IsActive}"
                            BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3" />
                    <Button Command="{Binding Command}"
                            Classes="sidebarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="9,5"
                            BorderThickness="0"
                            ToolTip.Tip="{Binding ToolTip}"
                            Height="28">
                      <Grid ColumnDefinitions="20,*,Auto">
                        <PathIcon Data="{Binding Icon}"
                                  Width="13"
                                  Height="13"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Detail}"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                   IsVisible="{Binding HasDetail}" />
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="RECENT"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding ActivityItems}" IsVisible="{Binding HasActivity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItemViewModel">
                  <Grid ColumnDefinitions="44,*" Margin="4,0,4,8">
                    <TextBlock Text="{Binding TimeLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}"
                                 FontSize="9"
                                 MaxLines="1"
                                 IsVisible="{Binding HasDetail}"
                                 Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
