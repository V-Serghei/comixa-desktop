<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Comixa.Desktop.ViewModels"
             x:Class="Comixa.Desktop.Views.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">
  <Border Background="{DynamicResource ComixaSurfaceElevatedBrush}">
    <Grid RowDefinitions="*,Auto">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,12,10,12" Spacing="16">
          <StackPanel Spacing="4" Margin="4,0,4,0">
            <TextBlock Text="Local library"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
            <TextBlock Text="{Binding LibraryStatsLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="LIBRARY"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding PrimaryNavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarNavigationItemViewModel">
                  <Panel Margin="0,1">
                    <Border IsVisible="{Binding IsActive}"
                            BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3" />
                    <Button Command="{Binding Command}"
                            Classes="sidebarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,8"
                            BorderThickness="0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Detail}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                   IsVisible="{Binding HasDetail}" />
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="STATUS"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding StatusNavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarNavigationItemViewModel">
                  <Panel Margin="0,1">
                    <Border IsVisible="{Binding IsActive}"
                            BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3" />
                    <Button Command="{Binding Command}"
                            Classes="sidebarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="12,8"
                            BorderThickness="0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Detail}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
              <TextBlock Text="FOLDERS"
                         FontSize="9"
                         FontWeight="SemiBold"
                         LetterSpacing="1.5"
                         Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
              <Button Grid.Column="1"
                      Content="+"
                      Command="{Binding ScanFolderCommand}"
                      Classes="sidebarButton"
                      Padding="6,0"
                      FontSize="14"
                      Foreground="{DynamicResource ComixaPrimaryBrush}"
                      ToolTip.Tip="Add folder" />
            </Grid>
            <ItemsControl ItemsSource="{Binding LibraryFolders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryFolderViewModel">
                <Panel Margin="4,1">
                  <Border IsVisible="{Binding IsActive}"
                          BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                          BorderThickness="3,0,0,0" />
                  <Button Command="{Binding SelectCommand}"
                          Classes="sidebarButton"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="10,8"
                          BorderThickness="0">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="174" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Path}"
                                   FontSize="9"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="132" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="9"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                      </Grid>
                    </StackPanel>
                  </Button>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
            <TextBlock Text="SHELVES"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="+"
                    Command="{Binding StartCreateShelfCommand}"
                    Classes="sidebarButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,0"
                    FontSize="16"
                    Foreground="{DynamicResource ComixaPrimaryBrush}"
                    ToolTip.Tip="New shelf" />
          </Grid>

          <Grid IsVisible="{Binding IsCreatingShelf}"
                ColumnDefinitions="*,Auto,Auto"
                Margin="8,0,8,6">
            <TextBox Text="{Binding NewShelfName}" PlaceholderText="Shelf name..." FontSize="12" />
            <Button Grid.Column="1"
                    Content="OK"
                    Command="{Binding ConfirmNewShelfCommand}"
                    Classes="readerPrimaryButton"
                    Margin="4,0,0,0"
                    Padding="8,5"
                    ToolTip.Tip="Create" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelNewShelfCommand}"
                    Classes="sidebarButton"
                    Margin="2,0,0,0"
                    Padding="8,5"
                    ToolTip.Tip="Cancel" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Shelves}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShelfViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="4,1">
                  <Button Command="{Binding SelectCommand}"
                          Classes="sidebarButton"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="12,8"
                          BorderThickness="0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="138" />
                  </Button>
                  <Button Grid.Column="1"
                          Content="Remove"
                          Command="{Binding DeleteCommand}"
                          Classes="dangerButton"
                          BorderThickness="0"
                          Padding="6,7"
                          FontSize="10"
                          ToolTip.Tip="Delete shelf" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="ACTIVITY"
                       Margin="6,0,0,0"
                       FontSize="9"
                       FontWeight="SemiBold"
                       LetterSpacing="1.5"
                       Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
            <ItemsControl ItemsSource="{Binding ActivityItems}" IsVisible="{Binding HasActivity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItemViewModel">
                  <Grid ColumnDefinitions="44,*" Margin="4,0,4,8">
                    <TextBlock Text="{Binding TimeLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}"
                                 FontSize="9"
                                 MaxLines="1"
                                 IsVisible="{Binding HasDetail}"
                                 Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1"
              BorderBrush="{DynamicResource ComixaOutlineBrush}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="10,8">
          <Button Command="{Binding RefreshLibraryCommand}"
                  Classes="sidebarButton"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="10,8"
                  BorderThickness="0"
                  Content="Refresh" />
          <Button Grid.Column="1"
                  Command="{Binding ToggleSettingsPanelCommand}"
                  Classes="sidebarButton"
                  Padding="10,8"
                  BorderThickness="0"
                  Content="Settings" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
