<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Comixa.Desktop.ViewModels"
             x:Class="Comixa.Desktop.Views.LibraryPaneView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False">

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:SingleLibraryItemViewModel">
      <Button Command="{Binding OpenCommand}"
              DoubleTapped="OnLibraryItemDoubleTapped"
              Background="Transparent"
              BorderThickness="0"
              Padding="4"
              Cursor="Hand">
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" Command="{Binding OpenCommand}" />
            <MenuItem Header="Open Fullscreen" Command="{Binding OpenFullscreenCommand}" />
            <Separator />
            <MenuItem Header="Mark as Read" Command="{Binding MarkAsReadCommand}" />
            <MenuItem Header="Mark as Unread" Command="{Binding MarkAsUnreadCommand}" />
            <Separator />
            <MenuItem Header="Add to shelf..."
                      ItemsSource="{Binding ShelfItems}"
                      IsVisible="{Binding HasShelfItems}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem">
                  <Setter Property="Header" Value="{ReflectionBinding MenuText}" />
                  <Setter Property="Command" Value="{ReflectionBinding ToggleCommand}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <MenuItem Header="No shelves yet"
                      IsVisible="{Binding !HasShelfItems}"
                      IsEnabled="False" />
            <MenuItem Header="New shelf..."
                      Command="{Binding CreateShelfCommand}" />
          </ContextMenu>
        </Button.ContextMenu>

        <Panel>
          <Border Width="100"
                  Background="{DynamicResource ComixaSurfaceBrush}"
                  BorderBrush="{DynamicResource ComixaOutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="7"
                  ClipToBounds="True">
            <Grid RowDefinitions="130,Auto,3">
              <Border Background="{DynamicResource ComixaSurfaceVariantBrush}">
                <Grid>
                  <Image Source="{Binding Item.CoverImage}"
                         Stretch="UniformToFill"
                         IsVisible="{Binding Item.HasCoverImage}" />
                  <Border IsVisible="{Binding Item.IsRead}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Background="{DynamicResource ComixaPrimaryBrush}"
                          CornerRadius="0,0,0,5"
                          Padding="5,2">
                    <TextBlock Text="✓"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#001B12" />
                  </Border>
                  <TextBlock Text="{Binding Item.Format}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ComixaPrimaryBrush}"
                             IsVisible="{Binding !Item.HasCoverImage}" />
                  <Border IsVisible="{Binding Item.HasProgress}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Background="{DynamicResource ComixaPrimaryBrush}"
                          CornerRadius="0,3,0,0"
                          Padding="4,2">
                    <TextBlock Text="{Binding Item.ReadStatusLabel}"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="#001B12" />
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Row="1" Margin="6,5,6,5">
                <TextBlock Text="{Binding Item.Title}"
                           Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Item.Metadata}"
                           Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                           FontSize="9"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <ProgressBar Grid.Row="2"
                           Value="{Binding Item.ProgressValue}"
                           Maximum="1.0"
                           IsVisible="{Binding Item.HasProgress}"
                           Foreground="{DynamicResource ComixaPrimaryBrush}"
                           Background="{DynamicResource ComixaOutlineBrush}" />
            </Grid>
          </Border>

          <Border Width="100"
                  BorderBrush="{DynamicResource ComixaPrimaryBrush}"
                  BorderThickness="2"
                  CornerRadius="7"
                  IsVisible="{Binding IsCurrentlyOpen}" />
        </Panel>
      </Button>
    </DataTemplate>

    <DataTemplate x:DataType="vm:SeriesLibraryItemViewModel">
      <Button Command="{Binding OpenCommand}"
              Background="Transparent"
              BorderThickness="0"
              Padding="4"
              Cursor="Hand">
        <Border Width="100"
                Background="{DynamicResource ComixaSurfaceBrush}"
                BorderBrush="{DynamicResource ComixaOutlineBrush}"
                BorderThickness="1"
                CornerRadius="7"
                ClipToBounds="True">
          <Grid RowDefinitions="130,Auto,3">
            <Panel Background="{DynamicResource ComixaSurfaceVariantBrush}">
              <Image Source="{Binding Cover.CoverImage}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding Cover.HasCoverImage}" />
              <TextBlock Text="Series"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ComixaSecondaryBrush}"
                         IsVisible="{Binding !Cover.HasCoverImage}" />
              <Border HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Background="{DynamicResource ComixaPrimaryBrush}"
                      CornerRadius="0,0,0,5"
                      Padding="4,2">
                <TextBlock Text="{Binding IssueCountLabel}"
                           FontSize="8"
                           FontWeight="Bold"
                           Foreground="#001B12" />
              </Border>
            </Panel>

            <StackPanel Grid.Row="1" Margin="6,5,6,5">
              <TextBlock Text="{Binding SeriesName}"
                         Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding IssueCountLabel}"
                         Foreground="{DynamicResource ComixaSecondaryBrush}"
                         FontSize="9"
                         Margin="0,1,0,0" />
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Value="{Binding ProgressValue}"
                         Maximum="1.0"
                         IsVisible="{Binding HasProgress}"
                         Foreground="{DynamicResource ComixaSecondaryBrush}"
                         Background="{DynamicResource ComixaOutlineBrush}" />
          </Grid>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12,10,12,0">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Text="{Binding LibraryViewTitle}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="10"
                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   MaxWidth="120"
                   TextTrimming="CharacterEllipsis" />
        <Button Content="+ Folder"
                Command="{Binding ScanFolderCommand}"
                Background="{DynamicResource ComixaPrimaryBrush}"
                Foreground="#001B12" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search..." />
      <Button Grid.Column="1"
              Content="Clear"
              Command="{Binding ClearSearchCommand}"
              IsVisible="{Binding HasSearchQuery}"
              Background="Transparent"
              Margin="4,0,0,0" />
    </Grid>

    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <ToggleButton Content="Unread"
                    Margin="0,0,4,4"
                    IsChecked="{Binding ShowUnreadOnly, Mode=OneWay}"
                    Command="{Binding ToggleUnreadOnlyCommand}" />
      <ToggleButton Content="CBZ"
                    Margin="0,0,4,4"
                    IsChecked="{Binding IsCbzFilterActive, Mode=OneWay}"
                    Command="{Binding ToggleCbzFilterCommand}" />
      <ToggleButton Content="ZIP"
                    Margin="0,0,4,4"
                    IsChecked="{Binding IsZipFilterActive, Mode=OneWay}"
                    Command="{Binding ToggleZipFilterCommand}" />
      <ToggleButton Content="PDF"
                    Margin="0,0,4,4"
                    IsChecked="{Binding IsPdfFilterActive, Mode=OneWay}"
                    Command="{Binding TogglePdfFilterCommand}" />
    </WrapPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="Sort:"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}" />
      <RadioButton Content="A-Z"
                   GroupName="Sort"
                   IsChecked="{Binding IsSortTitleAsc, Mode=OneWay}"
                   Command="{Binding SetSortOrderCommand}"
                   CommandParameter="title_asc" />
      <RadioButton Content="Z-A"
                   GroupName="Sort"
                   IsChecked="{Binding IsSortTitleDesc, Mode=OneWay}"
                   Command="{Binding SetSortOrderCommand}"
                   CommandParameter="title_desc" />
      <RadioButton Content="Added"
                   GroupName="Sort"
                   IsChecked="{Binding IsSortRecentlyAdded, Mode=OneWay}"
                   Command="{Binding SetSortOrderCommand}"
                   CommandParameter="recent_added" />
      <RadioButton Content="Read"
                   GroupName="Sort"
                   IsChecked="{Binding IsSortRecentlyRead, Mode=OneWay}"
                   Command="{Binding SetSortOrderCommand}"
                   CommandParameter="recent_read" />
    </StackPanel>

    <Grid Grid.Row="4">
      <Grid IsVisible="{Binding !IsInSeriesDetail}">
        <StackPanel IsVisible="{Binding IsLibraryEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="No comics here yet"
                     FontSize="15"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource ComixaOnSurfaceBrush}" />
          <TextBlock Text="Use Add Folder to scan your local comics"
                     TextAlignment="Center"
                     Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     MaxWidth="240" />
        </StackPanel>

        <ListBox x:Name="LibraryItemsList"
                 ItemsSource="{Binding DisplayedRows}"
                 IsVisible="{Binding !IsLibraryEmpty}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Margin="0,0,0,16"
                 Classes="libraryList"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel CacheLength="0.5" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LibraryRowViewModel">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsInSeriesDetail}">
        <Button Grid.Row="0"
                Content="Back"
                Command="{Binding BackToLibraryCommand}"
                Background="Transparent"
                Foreground="{DynamicResource ComixaPrimaryBrush}"
                HorizontalAlignment="Left"
                Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentSeriesName}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                   Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SeriesBooks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComicBookListItemViewModel">
                <Button Command="{Binding $parent[UserControl].DataContext.OpenBookCommand}"
                        CommandParameter="{Binding}"
                        DoubleTapped="OnLibraryItemDoubleTapped"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand">
                  <Border Padding="8,6"
                          Background="{DynamicResource ComixaSurfaceVariantBrush}"
                          CornerRadius="5"
                          ClipToBounds="True">
                    <Grid RowDefinitions="Auto,3" ColumnDefinitions="52,*">
                      <Border CornerRadius="3"
                              Width="46"
                              Height="60"
                              Background="{DynamicResource ComixaOutlineBrush}">
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasCoverImage}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Spacing="2">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource ComixaOnSurfaceBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Metadata}"
                                   Foreground="{DynamicResource ComixaPrimaryBrush}"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ReadStatusLabel}"
                                   Foreground="{DynamicResource ComixaOnSurfaceVariantBrush}"
                                   FontSize="9"
                                   IsVisible="{Binding HasProgress}" />
                      </StackPanel>
                      <ProgressBar Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Value="{Binding ProgressValue}"
                                   Maximum="1.0"
                                   IsVisible="{Binding HasProgress}"
                                   Foreground="{DynamicResource ComixaPrimaryBrush}"
                                   Background="{DynamicResource ComixaOutlineBrush}"
                                   Height="3" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
